+// VR: left-handed off-center perspective (same layout as D3DXMatrixPerspectiveOffCenterLH).
+// l, r, b, t are the near-plane extents at distance nr.
+void gxScene::setPerspProjOffAxis(float nr, float fr, float l, float r, float b, float t) {
+	frustum_nr = nr; frustum_fr = fr; frustum_w = r - l; frustum_h = t - b;
+	ortho_proj = false; off_axis_proj = true;
+	float Q = fr / (fr - nr);
+	projmatrix._11 = 2 * nr / (r - l);
+	projmatrix._22 = 2 * nr / (t - b);
+	projmatrix._31 = (l + r) / (l - r);
+	projmatrix._32 = (t + b) / (b - t);
+	projmatrix._33 = Q;
+	projmatrix._34 = 1;
+	projmatrix._43 = -Q * nr;
+	projmatrix._44 = 0;
+	currentProj = projmatrix;
+	dir3dDev->SetTransform(D3DTS_PROJECTION, &projmatrix);
+}
