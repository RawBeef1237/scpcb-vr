.lib "BlitzXR.dll"

; OpenXR bridge for BlitzX3D (32-bit). Needs openxr_loader.dll next to the exe and the
; VR engine build (GraphicsD3D9Device, BufferD3D9Surface, CameraProjOffAxis, SetRenderWorldBuffer).

XR_Init%(d3d9device%, appName$, resolutionScale#):"XR_Init"
XR_Shutdown():"XR_Shutdown"
XR_GetError$():"XR_GetError"
XR_RuntimeName$():"XR_RuntimeName"
XR_EyeWidth%():"XR_EyeWidth"
XR_EyeHeight%():"XR_EyeHeight"
XR_SetWorldScale(unitsPerMetre#):"XR_SetWorldScale"
XR_SetQuad(widthMetres#, distanceMetres#):"XR_SetQuad"
XR_IsRunning%():"XR_IsRunning"
XR_ExitRequested%():"XR_ExitRequested"
XR_FrameBegun%():"XR_FrameBegun"
XR_BeginFrame%():"XR_BeginFrame"
XR_Head#(index%):"XR_Head"
XR_EyeOffset#(eye%, index%):"XR_EyeOffset"
XR_EyeFov#(eye%, index%):"XR_EyeFov"
XR_Hand#(hand%, index%):"XR_Hand"
XR_HandValid%(hand%):"XR_HandValid"
XR_SubmitEye(eye%, surface%):"XR_SubmitEye"
XR_SubmitQuad(surface%):"XR_SubmitQuad"
XR_MirrorEye(eye%, surface%):"XR_MirrorEye"
XR_EndFrame():"XR_EndFrame"
XR_Recenter():"XR_Recenter"
XR_ButtonDown%(button%):"XR_ButtonDown"
XR_ButtonHit%(button%):"XR_ButtonHit"
XR_Axis#(axis%):"XR_Axis"
XR_Haptic(hand%, amplitude#, milliseconds%):"XR_Haptic"
