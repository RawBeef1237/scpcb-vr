From 03e1560d76df1e6b95322437244f3ba87593d670 Mon Sep 17 00:00:00 2001
From: "Aiden (local)" <local@localhost>
Date: Wed, 18 Nov 2026 16:30:10 -0500
Subject: [PATCH 5/5] Optionally load DXVK's d3d9.dll from a dxvk folder next
 to the exe

-dxvk on the command line, or BLITZ_D3D9=dxvk in the environment (a program can SetEnv it before its first graphics command), makes the runtime create its Direct3D 9 object from dxvk\d3d9.dll. Without either, or if that DLL can't be loaded, the system Direct3D 9 is used as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gxruntime/gxruntime.cpp | 44 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 43 insertions(+), 1 deletion(-)

diff --git a/gxruntime/gxruntime.cpp b/gxruntime/gxruntime.cpp
index 469da76..7a82703 100644
--- a/gxruntime/gxruntime.cpp
+++ b/gxruntime/gxruntime.cpp
@@ -1323,9 +1323,51 @@ void gxRuntime::closeFileSystem(gxFileSystem* f) {
 ////////////////////
 // GFX ENUM STUFF //
 ////////////////////
+// DXVK (Direct3D 9 on Vulkan) instead of the system Direct3D 9: "-dxvk" on the command line, or the
+// BLITZ_D3D9 environment variable set to "dxvk" (a program can SetEnv it before its first graphics
+// command). DXVK's d3d9.dll is loaded from a "dxvk" folder next to the exe, so the system Direct3D 9
+// stays the default and nothing changes unless it is asked for.
+static bool wantDXVK() {
+	char env[16] = "";
+	if (GetEnvironmentVariableA("BLITZ_D3D9", env, sizeof(env)) && !_stricmp(env, "dxvk")) return true;
+	const char* e = getenv("BLITZ_D3D9");
+	if (e && !_stricmp(e, "dxvk")) return true;
+	std::string cmd = GetCommandLineA();
+	for (char& c : cmd) c = (char)tolower((unsigned char)c);
+	size_t p = 0;
+	while ((p = cmd.find("-dxvk", p)) != std::string::npos) {
+		bool startOk = p == 0 || cmd[p - 1] == ' ' || cmd[p - 1] == '\t' || cmd[p - 1] == '"';
+		size_t q = p + 5;
+		bool endOk = q == cmd.size() || cmd[q] == ' ' || cmd[q] == '\t' || cmd[q] == '"';
+		if (startOk && endOk) return true;
+		p = q;
+	}
+	return false;
+}
+
+static HRESULT createD3D9Ex(IDirect3D9Ex** out) {
+	if (wantDXVK()) {
+		char path[MAX_PATH * 2];
+		DWORD n = GetModuleFileNameA(nullptr, path, MAX_PATH);
+		std::string dll = n ? std::string(path, n) : std::string();
+		size_t slash = dll.find_last_of("\\/");
+		dll = (slash == std::string::npos ? std::string() : dll.substr(0, slash + 1)) + "dxvk\\d3d9.dll";
+		HMODULE m = LoadLibraryA(dll.c_str());
+		typedef HRESULT(WINAPI* PFN_Direct3DCreate9Ex)(UINT, IDirect3D9Ex**);
+		PFN_Direct3DCreate9Ex create = m ? (PFN_Direct3DCreate9Ex)GetProcAddress(m, "Direct3DCreate9Ex") : nullptr;
+		if (create && SUCCEEDED(create(D3D_SDK_VERSION, out)) && *out) {
+			OutputDebugStringA(("Direct3D 9: DXVK (" + dll + ")\n").c_str());
+			return S_OK;
+		}
+		OutputDebugStringA(("DXVK was requested but " + dll + " could not be loaded; using the system Direct3D 9\n").c_str());
+		*out = nullptr;
+	}
+	return Direct3DCreate9Ex(D3D_SDK_VERSION, out);
+}
+
 void gxRuntime::ensureD3D() {
 	if (d3d) return;
-	if (FAILED(Direct3DCreate9Ex(D3D_SDK_VERSION, &d3d))) {
+	if (FAILED(createD3D9Ex(&d3d))) {
 		d3d = nullptr;
 		debugLog("Direct3D9 not available");
 	}
