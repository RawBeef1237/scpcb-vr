From fec72f27037c7b1c9946860dedbb9e777a28dd70 Mon Sep 17 00:00:00 2001
From: "Aiden (local)" <local@localhost>
Date: Wed, 18 Nov 2026 12:37:45 -0500
Subject: [PATCH 3/5] Don't let path helpers throw on names that are invalid in
 the ANSI code page

filenamefile/filenamepath/fullfilename, FileSize and AbsolutePath used std::filesystem::path on narrow strings. On a PC with a non-Western system locale (here Japanese, cp932) a texture path stored in a model (GFX\npcs\guard.b3d has a cp1251 path) throws std::system_error, which ended the program silently on level load.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 bbruntime/bbfilesystem.cpp |  5 ++++-
 gxruntime/gxfilesystem.cpp |  6 ++++-
 stdutil/stdutil.cpp        | 45 ++++++++++++++++++++++++--------------
 3 files changed, 38 insertions(+), 18 deletions(-)

diff --git a/bbruntime/bbfilesystem.cpp b/bbruntime/bbfilesystem.cpp
index 73f69a7..9474d26 100644
--- a/bbruntime/bbfilesystem.cpp
+++ b/bbruntime/bbfilesystem.cpp
@@ -233,7 +233,10 @@ void bbUnzip(BBStr* src, BBStr* dst, BBStr* password) {
 BBStr* bbAbsolutePath(BBStr* path) {
 	std::string file = path->c_str();
 	delete path;
-	return new BBStr(std::filesystem::absolute(file).generic_string());
+	// GetFullPathNameA instead of std::filesystem, which throws on names that are invalid in the ANSI code page
+	std::string full = fullfilename(file);
+	for (char& c : full) if (c == '\\') c = '/';
+	return new BBStr(full);
 }
 
 bool filesystem_create() {
diff --git a/gxruntime/gxfilesystem.cpp b/gxruntime/gxfilesystem.cpp
index 914f655..7561b0f 100644
--- a/gxruntime/gxfilesystem.cpp
+++ b/gxruntime/gxfilesystem.cpp
@@ -62,7 +62,11 @@ std::string gxFileSystem::getCurrentDir()const {
 }
 
 int gxFileSystem::getFileSize(const std::string& name)const {
-	return std::filesystem::exists(name) ? std::filesystem::file_size(name) : 0;
+	// GetFileAttributesExA instead of std::filesystem, which throws on names that are invalid in the ANSI code page
+	WIN32_FILE_ATTRIBUTE_DATA fad;
+	if (!GetFileAttributesExA(name.c_str(), GetFileExInfoStandard, &fad)) return 0;
+	if (fad.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) return 0;
+	return (int)fad.nFileSizeLow;
 }
 
 int gxFileSystem::getFileType(const std::string& name)const {
diff --git a/stdutil/stdutil.cpp b/stdutil/stdutil.cpp
index e9f6c11..1356cdd 100644
--- a/stdutil/stdutil.cpp
+++ b/stdutil/stdutil.cpp
@@ -222,31 +222,44 @@ std::string toupper(const std::string& s) {
 	return t;
 }
 
+// These work on the raw bytes instead of std::filesystem::path. fs::path converts narrow strings
+// through the Windows ANSI code page and throws std::system_error ("No mapping for the Unicode
+// character exists in the target multi-byte code page") when a name has bytes that are invalid in
+// that code page, e.g. a cp1251 texture path stored inside a .b3d on a PC whose system locale is
+// Japanese (cp932). That exception escaped to the runtime and ended the program.
+
 std::string fullfilename(const std::string& t) {
-	try {
-		return fs::absolute(fs::path(t)).string();
-	}
-	catch (const fs::filesystem_error&) {
-		return t;
-	}
+	char buf[MAX_PATH * 4];
+	DWORD n = GetFullPathNameA(t.c_str(), sizeof(buf), buf, nullptr);
+	if (n == 0 || n >= sizeof(buf)) return t;
+	return std::string(buf, n);
+}
+
+static size_t lastSeparator(const std::string& t) {
+	return t.find_last_of("\\/");
 }
 
 std::string filenamepath(const std::string& t) {
-	try {
-		return fs::path(t).parent_path().string();
-	}
-	catch (const fs::filesystem_error&) {
-		return "";
+	size_t n = lastSeparator(t);
+	if (n == std::string::npos) {
+		// "C:file" has a drive but no directory
+		return (t.size() >= 2 && t[1] == ':') ? t.substr(0, 2) : "";
 	}
+	// keep the root separator of "C:\file" and "\file", like fs::path::parent_path
+	if (n == 0 || (n == 2 && t[1] == ':')) return t.substr(0, n + 1);
+	// collapse repeated separators ("dir\\\file" -> "dir")
+	size_t e = n;
+	while (e > 0 && (t[e - 1] == '\\' || t[e - 1] == '/')) --e;
+	if (e == 0) return t.substr(0, 1);
+	return t.substr(0, e);
 }
 
 std::string filenamefile(const std::string& t) {
-	try {
-		return fs::path(t).filename().string();
-	}
-	catch (const fs::filesystem_error&) {
-		return "";
+	size_t n = lastSeparator(t);
+	if (n == std::string::npos) {
+		return (t.size() >= 2 && t[1] == ':') ? t.substr(2) : t;
 	}
+	return t.substr(n + 1);
 }
 
 const int MIN_SIZE = 256;
-- 
