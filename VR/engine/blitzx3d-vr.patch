+// SetRenderWorldBuffer buffer
+// Makes RenderWorld draw into a texture buffer (created with CreateTexture) instead of
+// the back buffer. Pass 0 to go back to the back buffer.
+void  bbSetRenderWorldBuffer(gxCanvas* c) {
+	if (!gx_scene) {
+		ErrorLog("SetRenderWorldBuffer", MultiLang::graphics_not_set);
+		return;
+	}
+	if (c == gx_graphics->getBackCanvas()) c = nullptr;
+	if (c) {
+		if (!gx_graphics->verifyCanvas(c) || !c->getSurface()) {
+			ErrorLog("SetRenderWorldBuffer", MultiLang::buffer_not_exist);
+			return;
+		}
+		D3DSURFACE_DESC desc;
+		if (FAILED(c->getSurface()->GetDesc(&desc)) || !(desc.Usage & D3DUSAGE_RENDERTARGET)) {
+			RTEX("SetRenderWorldBuffer: buffer is not a render target texture");
+		}
+	}
